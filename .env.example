# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True

# PostgreSQL
DB_NAME=personal_blog
DB_USER=personal_blog
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail SMTP example)
# Use django.core.mail.backends.console.EmailBackend to print mail locally instead.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=replace-with-a-google-app-password
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=your-address@gmail.com
CONTACT_RECEIVER_EMAIL=your-address@gmail.com
CONTACT_EMAIL_SUBJECT_PREFIX=[Personal Blog]
