# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL
DB_NAME=personal_blog
DB_USER=personal_blog
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# Liara's database connection page provides either a DATABASE_URL or the DB_*
# values needed to construct one. Prefer its private-network connection.
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL_REQUIRE=False

# HTTPS/security (use these values after your production domain has HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Uploaded files
# Local path. In Liara, create a disk and set MEDIA_ROOT=/data/media instead.
MEDIA_ROOT=media
MEDIA_URL=/media/
SERVE_MEDIA=True

# Email (Gmail SMTP example)
# Use django.core.mail.backends.console.EmailBackend to print mail locally instead.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=replace-with-a-google-app-password
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=your-address@gmail.com
CONTACT_RECEIVER_EMAIL=your-address@gmail.com
CONTACT_EMAIL_SUBJECT_PREFIX=[Personal Blog]
